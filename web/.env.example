# Copiez ce fichier en .env.local et renseignez vos clés Supabase.
# Sans ces deux variables, l'application tourne en MODE DÉMO (données locales au navigateur, code OTP 123456).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Côté Supabase (tableau de bord du projet) :
# - Authentication > Providers : activer Email, Phone (Twilio Verify, canaux SMS + WhatsApp) et Google
# - Authentication > URL configuration : ajouter http://localhost:3000/auth/callback
# - Appliquer le schéma : supabase db push  (supabase/migrations) puis supabase/seed.sql
