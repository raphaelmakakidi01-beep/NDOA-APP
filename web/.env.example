# Espace prestataire (Next.js) — copiez ce fichier en .env.local et remplissez les valeurs.
# .env.local n'est jamais envoyé sur GitHub (.gitignore).
# Sans les deux variables Supabase, l'application tourne en MODE DÉMO (données locales, code OTP 123456).

# Supabase > Project Settings > API : « Project URL » et clé « anon public »
# (clé publique, protégée par les règles RLS ; ne mettez JAMAIS la clé service_role ici)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Confirmation de l'e-mail à l'inscription : « lien » (par défaut, e-mail standard de Supabase)
# ou « code » (code à 6 chiffres : nécessite un SMTP personnalisé + le modèle supabase/templates/confirmation.html)
NEXT_PUBLIC_EMAIL_CONFIRMATION=lien

# Clé SERVEUR (Project Settings > API > service_role / secret) : utilisée uniquement par les routes
# /api/admin/* (nettoyage du stockage, comptes). Jamais de préfixe NEXT_PUBLIC_ : elle ne doit pas
# atteindre le navigateur. Facultative : sans elle, les fichiers d'une vitrine supprimée restent à nettoyer.
SUPABASE_SERVICE_ROLE_KEY=

# Adresses publiques (par défaut : https://ndoa.cd et https://pro.ndoa.cd)
NEXT_PUBLIC_PUBLIC_SITE_URL=
NEXT_PUBLIC_APP_URL=

# Côté Supabase (tableau de bord du projet) :
# - Authentication > Providers : activer Email, Phone (Twilio Verify, canaux SMS + WhatsApp) et Google
# - Authentication > URL configuration : ajouter https://pro.ndoa.cd/auth/callback
# - Appliquer le schéma : supabase db push (supabase/migrations) puis supabase/seed.sql
