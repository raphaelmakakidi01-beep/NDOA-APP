# Secrets des Edge Functions — à NE PAS mettre dans le code ni dans .env.local du site.
# En production : supabase secrets set --env-file supabase/functions/.env
# (SUPABASE_URL, SUPABASE_ANON_KEY et SUPABASE_SERVICE_ROLE_KEY sont fournis automatiquement par Supabase.)

# Agrégateur de paiement Mobile Money / carte
PAYMENT_API_URL=
PAYMENT_API_KEY=
# Secret partagé pour vérifier la signature HMAC des webhooks de paiement
PAYMENT_WEBHOOK_SECRET=

# Adresse de l'espace prestataire (liens dans les e-mails d'invitation, retours de paiement)
SITE_URL=
